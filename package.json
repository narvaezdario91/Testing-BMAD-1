{
  "name": "ai-testing-bmad-1",
  "version": "1.0.0",
  "description": "Enterprise Test Automation Framework with Playwright BDD (vitalets), SOLID and TEA methodology",
  "scripts": {
    "bdd:gen": "bddgen",
    "test": "bddgen && playwright test",
    "test:p0": "bddgen && playwright test --grep \"@P0\"",
    "test:p1": "bddgen && playwright test --grep \"@P0|@P1\"",
    "test:all": "bddgen && playwright test",
    "test:ui": "bddgen && playwright test --ui",
    "test:report": "playwright show-report _bmad-output/test-artifacts/playwright-report"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.5.0",
    "@playwright/test": "^1.50.1",
    "@types/node": "^22.13.5",
    "dotenv": "^16.4.7",
    "playwright-bdd": "^8.2.0",
    "typescript": "^5.7.3"
  }
}